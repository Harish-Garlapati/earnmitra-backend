# Earnmitra Backend Environment Configuration
PORT=3000

# Database Configuration (XAMPP / MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=earnmitra
DB_CONNECTION_LIMIT=10

# Partner authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
DEV_OTP_EXPOSE=false

# Fast2SMS OTP delivery (server-side only)
# These values must match the approved India DLT sender and OTP template.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=
FAST2SMS_API_URL=https://www.fast2sms.com/dev/bulkV2

# CIBIL provider (server-side only; never expose these values in Angular)
SUREPASS_CIBIL_API_URL=
SUREPASS_CIBIL_API_KEY=
# Comma-separated exact HTTPS hostnames allowed for provider PDF downloads.
CIBIL_REPORT_ALLOWED_HOSTS=
